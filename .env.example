# Gemini API key, free from https://aistudio.google.com/apikey. Required for AI generation.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash)
GEMINI_MODEL=

# Upstash Redis (Vercel Marketplace -> Upstash for Redis). Required in production so
# stores persist. Vercel's integration sets KV_REST_API_URL / KV_REST_API_TOKEN for you;
# the UPSTASH_* names work too. Locally, if these are empty, stores live in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
